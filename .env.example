# ==============================================================================
# NIC FleetHub — Enterprise Environment Configuration Template
# National Industries Company (K.S.C.C) Kuwait
# ==============================================================================

# Server & Network Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=false

# Persistent Storage Paths (SQLite & Uploads)
FLEETHUB_DATA=./backend/data
FLEETHUB_DB=./backend/data/fleethub.db
FLEETHUB_UPLOADS=./backend/uploads

# Cryptographic Session Key (32-byte hexadecimal secret)
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key

# Default Administrator Seed Password (used only on first database initialization)
FLEETHUB_ADMIN_PASSWORD=admin12345

# Allowed CORS Origins (Comma-separated for local and cloud deployment)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,https://nic-fleethub.vercel.app

# Cookie Security (Production should set to 1 or true)
COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Regional Operations Configuration
FLEETHUB_COUNTRY=Kuwait
FLEETHUB_BASE_CURRENCY=KWD
FLEETHUB_DEFAULT_LANG=en
