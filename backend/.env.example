# Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=false

# SQLite Database & Storage Paths
FLEETHUB_DATA=./data
FLEETHUB_DB=./data/fleethub.db
FLEETHUB_UPLOADS=./uploads

# Admin User Seed (Initial setup)
FLEETHUB_ADMIN_PASSWORD=admin12345

# Security
SECRET_KEY=change_this_to_a_random_32_byte_hex_secret

# CORS Allowed Origins (Comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# Regional Defaults
FLEETHUB_COUNTRY=Kuwait
FLEETHUB_BASE_CURRENCY=KWD
FLEETHUB_DEFAULT_LANG=en
